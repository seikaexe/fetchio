{
  "name": "fetchio",
  "version": "1.0.0",
  "private": true,
  "description": "Fetchio media downloader starter",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/dev-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ytdlp:check": "tsx src/scripts/ytdlp-check.ts"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
