PORT=3000
CORS_ORIGIN=*
# Opsional: origin publik untuk link /file (default: dari header Host)
# PUBLIC_BASE_URL=https://fetchio.example.com

# ---- yt-dlp (dipasang di server, tidak ada di repository) ----
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_AUTO_DOWNLOAD=0          # 0 = jangan unduh otomatis kalau yt-dlp tidak ditemukan
# YTDLP_COOKIES_FILE=/run/secrets/yt-cookies.txt
# YTDLP_COOKIES_BASE64=          # isi cookies.txt format Netscape yang sudah di-Base64 (Vercel)
# YOUTUBE_COOKIES=               # isi cookies format Netscape biasa (alternatif)
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_REMOTE_COMPONENTS=ejs:github   # hanya jika yt-dlp BUKAN executable resmi
# YTDLP_MAX_PARALLEL=3

# ---- MP3 (butuh ffmpeg) ----
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_MAX_PARALLEL=2
